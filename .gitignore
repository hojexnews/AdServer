ml/registry/artifacts/
ml/registry/mlruns/
ml/training/testdata/sample_train.parquet

# Binarios Go compilados na raiz (saida de `go build`/`make dev-*-run`), nao versionar
/decision
/collector
/adtag
/ranker-sidecar

# Cache incremental do TypeScript (build artifact, nao versionar)
*.tsbuildinfo

# Node.js / web e BFF (nunca commitar node_modules)
node_modules/
.next/
dist/
bff/dist/
web/console/.next/
