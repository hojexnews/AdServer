# Codigo gerado pelo buf: a partir da Fase 1 (ADR-0002 §C), gen/ e VERSIONADO
# na raiz. proto/gen/ nunca foi usada e nao existe; mantemos aqui apenas como
# guardrail caso alguma ferramenta a crie acidentalmente.
proto/gen/
# Binários locais de tooling
.bin/
# State de IaC (NUNCA versionar)
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
# Segredos
*.env
.env

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Python build/packaging artifacts (gerados por pip install -e / build)
*.egg-info/

# Python virtual environment (ml/ usa ml/.venv; copilot usa services/copilot/.venv)
ml/.venv/
services/copilot/.venv/

# Modelos e artefatos binarios de ML — gerenciados pelo MLflow registry, nao pelo git
# ADR-0003 §F: "Modelos compilados (ONNX/Treelite) NAO sao versionados no git como blobs"
# Toda a pasta de artefatos de treino e saida gerada (onnx/lgb/calibration/reliability).
ml/registry/artifacts/
ml/registry/mlruns/
ml/training/testdata/sample_train.parquet
ml/fraud/testdata/*.parquet
# Fase 3 K1: artefatos do deep ranker (gerados pelos testes/treino, regeneraveis)
ml/deep/testdata/*.parquet
ml/deep/testdata/*.onnx
ml/deep/testdata/*.onnx.data
# MLflow local tracking dir (criado em ./mlruns quando o treino roda da raiz do repo)
mlruns/

# Binarios Go compilados na raiz (saida de `go build`/`make dev-*-run`), nao versionar
/decision
/collector
/adtag
/ranker-sidecar

# Cache incremental do TypeScript (build artifact, nao versionar)
*.tsbuildinfo

# Node.js / web e BFF (nunca commitar node_modules)
node_modules/
.next/
dist/
bff/dist/
web/console/.next/
