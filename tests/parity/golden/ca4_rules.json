        {"vector": "TimeDayOfWeek", "operator": "is_not", "value": "3"},
        {"vector": "TimeDayOfWeek", "operator": "is_not", "value": "4"},
        {"vector": "TimeDayOfWeek", "operator": "is_not", "value": "5"},
