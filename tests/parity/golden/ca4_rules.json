  {
    "id": "CA4-014",
    "description": "AND: todas as condicoes devem passar — uma falha descarta",
    "ca": "CA-4",
    "sub": "and-all-must-pass",
    "input": {
      "rule_logic": "AND",
      "conditions": [
        {"vector": "GeoCountry", "operator": "is", "value": "BR"},
        {"vector": "GeoCity", "operator": "is", "value": "Rio de Janeiro"}
      ],
      "context": {"country": "BR", "city": "Sao Paulo"}
    },
    "expect": {
      "eligible": false,
      "comment": "Pais bate mas cidade nao bate; AND exige ambos"
    }
  },
  {
    "id": "CA4-015",
    "description": "OR: qualquer condicao satisfaz — uma verdadeira e suficiente",
    "ca": "CA-4",
    "sub": "or-any-passes",
    "input": {
      "rule_logic": "OR",
      "conditions": [
        {"vector": "GeoCountry", "operator": "is", "value": "US"},
        {"vector": "GeoCity", "operator": "is", "value": "Sao Paulo"}
      ],
      "context": {"country": "BR", "city": "Sao Paulo"}
    },
    "expect": {
      "eligible": true,
      "comment": "Pais nao bate (BR != US) mas cidade bate; OR e suficiente"
    }
  },
