  {
    "id": "CA4-018",
    "description": "RuleSet ID desconhecido: fail-closed — inelegivel",
    "ca": "CA-4",
    "sub": "unknown-ruleset-ineligible",
    "input": {
      "rule_set_ids": ["nonexistent-ruleset-id"],
      "context": {"country": "BR"}
    },
    "expect": {
