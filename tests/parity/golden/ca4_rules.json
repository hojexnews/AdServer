[
  {
    "id": "CA4-001",
    "description": "Geo-Country IS 'BR': request do Brasil e elegivel",
    "ca": "CA-4",
    "sub": "geo-country-is-match",
    "input": {
      "rule_logic": "AND",
      "conditions": [{"vector": "GeoCountry", "operator": "is", "value": "BR"}],
      "context": {"country": "BR", "city": "Sao Paulo"}
