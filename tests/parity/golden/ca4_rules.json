  {
    "id": "CA4-023",
    "description": "RuleSet com Impossible=true silencia o banner apos Validate()",
    "ca": "CA-4",
    "sub": "impossible-ruleset-blocks-banner",
    "input": {
      "rule_logic": "AND",
      "conditions": [
        {"vector": "GeoCountry", "operator": "is", "value": "BR"},
        {"vector": "GeoCountry", "operator": "is", "value": "US"}
      ],
      "validate_first": true,
      "context": {"country": "BR"}
