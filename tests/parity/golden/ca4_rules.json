  {
    "id": "CA4-019",
    "description": "Anti-contradicao: AND com dois IS no mesmo vetor => Impossible (CA-4)",
    "ca": "CA-4",
    "sub": "anticontradiction-two-is-same-vector",
    "input": {
      "rule_logic": "AND",
      "conditions": [
        {"vector": "GeoCountry", "operator": "is", "value": "BR"},
        {"vector": "GeoCountry", "operator": "is", "value": "US"}
      ],
      "context": {"country": "BR"}
    },
    "expect": {
      "eligible": false,
      "impossible_after_validate": true,
      "comment": "Request so pode ter um pais; AND com dois IS diferentes e impossivel — silencia o banner (CA-4)"
    }
  },
  {
    "id": "CA4-020",
    "description": "Anti-contradicao: IS 'BR' AND IS-NOT 'BR' no mesmo vetor => Impossible",
    "ca": "CA-4",
    "sub": "anticontradiction-is-and-isnot-same-value",
    "input": {
      "rule_logic": "AND",
      "conditions": [
        {"vector": "GeoCountry", "operator": "is", "value": "BR"},
        {"vector": "GeoCountry", "operator": "is_not", "value": "BR"}
      ],
      "context": {"country": "BR"}
    },
    "expect": {
      "eligible": false,
      "impossible_after_validate": true,
      "comment": "IS BR AND IS-NOT BR e logicamente impossivel — silencia o banner"
    }
  },
