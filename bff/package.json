{
  "name": "@adserver/bff",
  "version": "0.1.0",
  "private": true,
  "description": "BFF — fronteira de ACL (CA-1) do console self-service. tRPC v11 + Zod.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --passWithNoTests"
  },
  "dependencies": {
    "@trpc/server": "11.0.0",
    "decimal.js": "10.4.3",
    "pg": "^8.13.3",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.13",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "^9.28.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
